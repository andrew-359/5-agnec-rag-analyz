{
  "name": "rag-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare:demo": "tsx scripts/prepare-demo.ts",
    "dev": "concurrently -k 'tsx watch src/server/index.ts' 'vite --host 127.0.0.1'",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsup src/server/index.ts --format esm --platform node --out-dir dist/server --clean",
    "start": "node dist/server/index.js",
    "test": "node --test tests/*.test.ts",
    "test:qa": "node --test tests/article-upload-contract.test.ts tests/article-delivery.test.ts tests/article-release.test.ts tests/article-run-routes.test.ts tests/comparison.test.ts tests/document-cli.test.ts tests/lab-publication-contract.test.ts tests/ocr-discovery-plan.test.ts tests/plot-publications.test.ts tests/regional-table-reading-plan.test.ts tests/review-context.test.ts tests/review-draft.test.ts tests/review-mcp.test.ts tests/run-progress.test.ts",
    "test:e2e": "node --test tests/lab/*.test.ts",
    "lint": "eslint src scripts",
    "build:client": "vite build"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.94",
    "@hono/node-server": "2.1.11",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tanstack/react-query": "5.108.2",
    "@tanstack/react-table": "8.21.3",
    "@trpc/client": "11.29.5",
    "@trpc/server": "11.29.5",
    "@trpc/tanstack-react-query": "11.29.5",
    "ai": "7.0.179",
    "amqplib": "2.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hono": "4.13.19",
    "lucide-react": "1.77.0",
    "pdfjs-dist": "5.7.284",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "8.5.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/eslint-parser": "8.1.2",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "tailwindcss": "4.3.5",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
