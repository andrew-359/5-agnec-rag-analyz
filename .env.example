# Полный запуск через docker compose из корня.
# Укажите абсолютный путь к распакованному комплекту с tools/check_submission.py.
RAG_CORPUS_DIR=/absolute/path/to/viniti-corpus
COMPOSE_PROJECT_NAME=rag-local
RAG_BIND_IP=127.0.0.1
RAG_BIND_PORT=4310
# SOURCE_COMMIT=local

# Веб и воркер на хосте, отдельный compose.rabbitmq.yaml для брокера.
# RAG_RABBITMQ_PASSWORD=replace-local-password
# RAG_RABBITMQ_PORT=5672
# RAG_AMQP_URL=amqp://rag:replace-local-password@127.0.0.1:5672/%2F
# RAG_AMQP_QUEUE=rag.article-extraction
# RAG_ARTICLE_STORE=/absolute/path/to/shared/article-store
# RAG_PUBLICATION_STORE=/absolute/path/to/publications
# RAG_PYTHON=/absolute/path/to/.venv/bin/python
# RAG_SUBMISSION_CHECKER=/absolute/path/to/viniti-corpus/tools/check_submission.py

# Адрес уже запущенного Ollama из среды Python-воркера. См. ops/ollama.md.
# При запуске воркера напрямую на той же машине:
# RAG_OLLAMA_URL=http://127.0.0.1:11434
# Для воркера в Compose и Ollama на хосте (доступ из контейнера настраивается отдельно):
# RAG_OLLAMA_URL=http://host.docker.internal:11434
